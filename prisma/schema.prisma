// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Authentication ────────────────────────────────────────

enum Role {
  ADMIN
  DRIVER
  CUSTOMER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driverId String? @unique
  driver   Driver? @relation(fields: [driverId], references: [id])

  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model DriverLeave {
  id        String      @id @default(uuid())
  driverId  String
  driver    Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  reason    String
  status    LeaveStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// ─── Driver Enums ────────────────────────────────────────

enum DriverStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
  SUSPENDED
}

enum EmploymentType {
  FULL_TIME
  CONTRACT
  FREELANCE
}

// Saudi license categories per Muroor (Traffic Dept)
enum LicenseType {
  PRIVATE // Light vehicles
  PUBLIC_LIGHT // Taxi / public transport (light)
  PUBLIC_HEAVY // Bus / public transport (heavy)
  HEAVY_EQUIPMENT // Heavy trucks, trailers
  MOTORCYCLE
}

enum Gender {
  MALE
  FEMALE
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  O_POS
  O_NEG
  AB_POS
  AB_NEG
}

enum MedicalFitness {
  FIT
  UNFIT
  PENDING
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

// Saudi-specific: residency type
enum ResidencyType {
  SAUDI_NATIONAL
  IQAMA_HOLDER // Expat with residence permit
  VISIT_VISA // Temporary
  TRANSIT
}

enum VisaType {
  WORK_VISA
  VISIT_VISA
  TRANSIT_VISA
  HAJJ_UMRAH
  PREMIUM_RESIDENCY // Saudi Green Card equivalent
}

// ─── Driver Model ────────────────────────────────────────

model Driver {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Personal Information ──
  employeeId      String      @unique // Auto-generated: DRV-001
  firstName       String
  lastName        String
  dateOfBirth     DateTime
  gender          Gender?
  bloodGroup      BloodGroup?
  nationality     String? // e.g. "Indian", "Pakistani", "Bangladeshi", "Saudi"
  profilePhotoUrl String?

  // ── Saudi ID & Residency ──
  residencyType    ResidencyType @default(IQAMA_HOLDER)
  iqamaNumber      String?       @unique // Iqama (residence permit) for expats
  iqamaExpiryDate  DateTime? // ⚠️ Critical compliance
  nationalIdNumber String?       @unique // Saudi national ID (for citizens)
  sponsorName      String? // Kafeel / sponsor company
  borderNumber     String? // Border entry number

  // ── Passport (most drivers are expats) ──
  passportNumber         String?   @unique
  passportIssuingCountry String?
  passportIssueDate      DateTime?
  passportExpiryDate     DateTime? // ⚠️ Critical compliance
  visaType               VisaType?
  visaExpiryDate         DateTime? // ⚠️ Critical compliance

  // ── Contact Details ──
  phone            String
  alternatePhone   String?
  email            String?
  currentAddress   String // Saudi address
  permanentAddress String? // Home country address
  city             String? // e.g. Riyadh, Jeddah, Dammam
  region           String? // Saudi region/province
  postalCode       String? // Saudi postal code (5 digits)

  // ── Emergency Contact ──
  emergencyContactName     String
  emergencyContactPhone    String
  emergencyContactRelation String

  // ── Employment Details ──
  dateOfJoining     DateTime
  employmentType    EmploymentType @default(FULL_TIME)
  status            DriverStatus   @default(ACTIVE)
  department        String?
  salary            Float? // SAR monthly
  bankName          String? // e.g. Al Rajhi, SNB, Alinma
  ibanNumber        String? // Saudi IBAN (SA + 22 digits)
  gosiNumber        String? // GOSI social insurance number
  terminationDate   DateTime?
  terminationReason String?
  notes             String?

  // ── Saudi Driving License ──
  licenseNumber           String      @unique
  licenseType             LicenseType @default(HEAVY_EQUIPMENT)
  licenseIssuingAuthority String? // Muroor region
  licenseIssueDate        DateTime
  licenseExpiryDate       DateTime // ⚠️ Critical compliance
  hazmatCertified         Boolean     @default(false)
  defensiveDrivingCert    Boolean     @default(false)

  // ── Transport Authority Registration ──
  waselRegistrationNumber String? // MOT WASEL platform
  tgaCardNumber           String? // TGA (Transport General Authority) card
  tgaCardExpiry           DateTime? // ⚠️ Compliance

  // ── Medical & Fitness ──
  medicalCertificateUrl  String?
  medicalCertExpiry      DateTime? // ⚠️ Compliance
  medicalFitness         MedicalFitness     @default(PENDING)
  knownMedicalConditions String?
  drugTestDate           DateTime? // Mandatory in KSA
  drugTestResult         VerificationStatus @default(PENDING)

  // ── Background & Compliance ──
  backgroundCheckStatus    VerificationStatus @default(PENDING)
  backgroundCheckDate      DateTime?
  saudiPoliceCheck         VerificationStatus @default(PENDING) // Saudi police clearance
  saudiPoliceCheckDate     DateTime?
  homeCountryClearance     VerificationStatus @default(PENDING) // Home country police clearance
  homeCountryClearanceDate DateTime?
  saherViolations          Int                @default(0) // Count of SAHER traffic violations

  // ── Relations ──
  orders         Order[]
  user           User?
  leaves         DriverLeave[]
  primaryVehicle Vehicle? @relation("PrimaryVehicle")
}

// ─── Vehicle Enums ────────────────────────────────────────

enum VehicleStatus {
  ACTIVE
  IN_MAINTENANCE
  OUT_OF_SERVICE
  DECOMMISSIONED
  RESERVED
}

// Vehicle types are now dynamic — stored in VehicleCategory model
model VehicleCategory {
  id          String   @id @default(uuid())
  slug        String   @unique   // e.g. RIGID_TRUCK
  name        String              // e.g. "Rigid Truck"
  description String?
  icon        String?             // Emoji or icon identifier
  isDefault   Boolean  @default(false) // System-provided type
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── Classification ──
  vehicleClass     String?   // LIGHT, MEDIUM, HEAVY, SUPER_HEAVY, EQUIPMENT
  bodyType         String?   // BOX, FLATBED, TANKER, REFRIGERATED, CURTAINSIDE, LOWBED, TIPPER, CHASSIS, VAN, PICKUP, CRANE, FORKLIFT, EXCAVATOR, BOOM_LIFT, etc.
  primaryUse       String?   // FREIGHT, PASSENGER, CONSTRUCTION, MATERIAL_HANDLING, LIFTING, EARTHMOVING, SPECIALIZED, SUPPORT

  // ── Capacity Defaults ──
  minPayloadTons   Float?    // Minimum payload capacity for this type
  maxPayloadTons   Float?    // Maximum payload capacity for this type
  maxGvwKg         Float?    // Max Gross Vehicle Weight (kg)
  palletCapacity   Int?      // Max standard pallet count (EUR/GCC)
  volumeCapacityM3 Float?    // Cargo volume capacity (m³)

  // ── Dimensions (typical range for this type) ──
  typicalLengthM   Float?    // Typical overall length (meters)
  typicalWidthM    Float?    // Typical width (meters)
  typicalHeightM   Float?    // Typical height (meters)
  maxHeightM       Float?    // Max height allowed in KSA (4.8m general)
  maxLengthM       Float?    // Max length allowed by Saudi road law

  // ── Axle & Wheel Configuration ──
  axleConfig       String?   // e.g. "4x2", "6x4", "8x4"
  minAxles         Int?
  maxAxles         Int?
  typicalWheelCount Int?

  // ── Engine & Fuel Defaults ──
  defaultFuelType    String?  // DIESEL, PETROL, ELECTRIC, CNG, LPG, HYBRID
  minEnginePowerHp   Int?
  maxEnginePowerHp   Int?
  transmissionTypes  String?  // Comma-separated: MANUAL,AUTOMATIC,AMT

  // ── Saudi Regulatory Constraints ──
  requiresTgaCard    Boolean @default(false)  // Needs TGA operation card
  requiresWasel      Boolean @default(false)  // WASEL GPS tracking mandatory
  requiresSpeedLimiter Boolean @default(false)
  defaultSpeedLimitKmh Int?                    // Default speed limit for this type
  minDriverLicenseType String?                 // Minimum Saudi license category required
  requiresHazmatCert   Boolean @default(false) // Driver needs hazmat certification
  requiresMvpiFrequency String?               // MVPI inspection frequency: ANNUAL, BIANNUAL

  // ── Operational Attributes ──
  temperatureControlled Boolean @default(false) // Reefer / cold chain
  minTempCelsius       Float?                   // Min temp if temperature controlled
  maxTempCelsius       Float?                   // Max temp range
  adrClass             String?                  // Dangerous goods class if applicable
  canCarryHazmat       Boolean @default(false)
  canCarryLivestock    Boolean @default(false)
  canCarryOversized    Boolean @default(false)
  requiresCrane        Boolean @default(false)  // Has/requires onboard crane
  requiresTailLift     Boolean @default(false)  // Has/requires tail lift

  // ── Cost & Maintenance Defaults ──
  estimatedDailyRateSar Float?   // Default daily rental/operational rate (SAR)
  typicalServiceIntervalKm Float? // Default service interval in km
  typicalServiceIntervalDays Int?  // Default service interval in days
  estimatedFuelConsumption Float? // L/100km typical
  tireSizeSpec           String?  // Typical tire spec e.g. "315/80R22.5"
  numberOfTires          Int?

  // ── Insurance & Compliance ──
  insuranceCategory     String?  // Insurance classification tier
  defaultInsuranceType  String?  // COMPREHENSIVE, THIRD_PARTY, AGAINST_OTHERS

  // ── Display & Sorting ──
  sortOrder             Int      @default(0)  // Display order in UI
  colorHex              String?  // Brand color for UI cards
  isActive              Boolean  @default(true) // Soft-disable without deleting
}

enum FuelType {
  DIESEL
  PETROL
  HYBRID
  ELECTRIC
  CNG   // Compressed natural gas
  LPG   // Liquified petroleum gas
}

enum InsuranceType {
  COMPREHENSIVE
  THIRD_PARTY
  AGAINST_OTHERS  // Saudi standard "against others"
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  EMERGENCY
  SCHEDULED
  OVERHAUL
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

enum DocumentType {
  ISTIMARA             // Vehicle registration
  INSURANCE_POLICY
  TGA_OPERATION_CARD   // TGA commercial authorization
  MVPI_CERTIFICATE     // Motor Vehicle Periodic Inspection
  WASEL_CERTIFICATE    // WASEL platform enrollment
  CUSTOMS_CLEARANCE
  WEIGHT_CERTIFICATE
  HAZMAT_PERMIT
  ROUTE_PERMIT
  SPEED_LIMITER_CERT
  OTHER
}

// ─── Vehicle Model ────────────────────────────────────────

model Vehicle {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Identification ──
  fleetNumber  String        @unique  // Internal fleet ID: VH-001
  make         String                 // e.g. Mercedes, Isuzu, Hino
  model        String                 // e.g. Actros 2645
  year         Int?                   // Manufacturing year
  color        String?
  vehicleType  String        @default("RIGID_TRUCK")  // References VehicleCategory.slug
  status       VehicleStatus @default(ACTIVE)
  photoUrl     String?

  // ── Saudi Registration (Istimara) ──
  licensePlate      String   @unique  // Saudi plate: e.g. أ ب ج 1234
  chassisNumber     String?  @unique  // VIN / Chassis number
  engineNumber      String?
  istimaraNumber    String?  @unique  // Registration serial
  istimaraExpiry    DateTime?         // ⚠️ Critical compliance
  registrationCity  String?           // Muroor branch city

  // ── Capacity & Dimensions ──
  capacity          Float              // Payload capacity (tons)
  grossVehicleWeight Float?            // GVW in kg
  netWeight          Float?            // Tare weight in kg
  numberOfAxles      Int?
  lengthMeters       Float?            // Overall length
  widthMeters        Float?
  heightMeters       Float?            // Max height (limit: 4.8m in KSA)

  // ── Engine & Fuel ──
  fuelType          FuelType  @default(DIESEL)
  tankCapacityLiters Float?
  engineCapacityCC   Int?              // Engine displacement
  transmissionType   String?           // Manual / Automatic
  horsePower         Int?

  // ── Saudi Regulatory ──
  tgaOperationCardNumber String?       // TGA commercial operation card
  tgaOperationCardExpiry DateTime?     // ⚠️ Compliance
  waselTrackerId         String?       // WASEL GPS tracker ID
  waselConnected         Boolean  @default(false)
  speedLimiterInstalled  Boolean  @default(false)
  speedLimitKmh          Int?          // Max allowed speed (90/100/80 by type)

  // ── Insurance ──
  insuranceProvider   String?
  insurancePolicyNo   String?
  insuranceType       InsuranceType? @default(COMPREHENSIVE)
  insuranceStartDate  DateTime?
  insuranceExpiryDate DateTime?       // ⚠️ Compliance

  // ── MVPI (Fahes / Periodic Inspection) ──
  lastMvpiDate    DateTime?           // Last inspection
  nextMvpiDate    DateTime?           // ⚠️ Compliance
  mvpiStation     String?             // Inspection station name
  mvpiResult      String?             // PASS / FAIL

  // ── Odometer & Usage ──
  currentOdometerKm   Float   @default(0)
  lastOdometerUpdate  DateTime?
  averageDailyKm      Float?

  // ── Maintenance Schedule ──
  nextServiceDueKm    Float?           // Km-based service interval
  nextServiceDueDate  DateTime?        // Date-based service interval
  tireChangeKm        Float?           // Next tire rotation/change
  oilChangeKm         Float?           // Next oil change interval

  // ── Assignment ──
  assignedDriverId String?  @unique        // Primary assigned driver
  assignedDriver   Driver?  @relation("PrimaryVehicle", fields: [assignedDriverId], references: [id])

  notes String?

  // ── Relations ──
  orders              Order[]
  maintenanceRecords  MaintenanceRecord[]
  fuelLogs            FuelLog[]
  vehicleDocuments    VehicleDocument[]
  inspections         VehicleInspection[]
}

// ─── Maintenance Records ────────────────────────────────────

model MaintenanceRecord {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicleId    String
  vehicle      Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  type         MaintenanceType  @default(PREVENTIVE)
  status       MaintenanceStatus @default(SCHEDULED)
  title        String                      // Brief description
  description  String?                     // Detailed work description
  scheduledDate DateTime?
  startDate     DateTime?
  completedDate DateTime?
  odometerAtService Float?                 // Km at time of service

  // ── Cost ──
  laborCostSar    Float?                   // Labor cost in SAR
  partsCostSar    Float?                   // Parts cost in SAR
  totalCostSar    Float?                   // Total cost in SAR
  vendor          String?                  // Workshop / service provider
  invoiceNumber   String?
  warrantyUntil   DateTime?

  // ── Parts Replaced ──
  partsReplaced   String?                  // JSON or comma-separated list

  // ── Next Service ──
  nextServiceDate DateTime?
  nextServiceKm   Float?

  notes String?
}

// ─── Fuel Logs ────────────────────────────────────

model FuelLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  vehicleId  String
  vehicle    Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  date         DateTime
  fuelType     FuelType  @default(DIESEL)
  liters       Float
  costPerLiter Float?               // SAR per liter
  totalCostSar Float?               // Total fill cost
  odometerKm   Float?               // Odometer at fill
  station      String?              // Gas station name
  driverName   String?              // Who fueled
  fullTank     Boolean  @default(true)

  notes String?
}

// ─── Vehicle Documents ────────────────────────────────────

model VehicleDocument {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicleId    String
  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  documentType DocumentType
  title        String
  fileUrl      String?               // Uploaded file path/URL
  issueDate    DateTime?
  expiryDate   DateTime?             // ⚠️ Tracked for compliance
  issuedBy     String?               // Issuing authority
  referenceNo  String?               // Document reference number

  notes String?
}

// ─── Vehicle Inspections (pre-trip / post-trip) ────────────

model VehicleInspection {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  vehicleId    String
  vehicle      Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  inspectionType String  @default("PRE_TRIP") // PRE_TRIP / POST_TRIP / SPOT_CHECK
  inspectedBy    String?                      // Driver or inspector name
  date           DateTime

  // ── Checklist Results (stored as JSON) ──
  checklistJson  String?                      // JSON: { tires: "PASS", brakes: "PASS", ... }
  overallResult  String   @default("PASS")    // PASS / FAIL / NEEDS_ATTENTION
  failReasons    String?                      // If FAIL, what failed
  odometerKm     Float?

  notes String?
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT    // Lead / potential customer
  ON_HOLD     // Payment issues, etc.
  BLACKLISTED // Do not serve
}

enum CustomerType {
  CORPORATE
  SME              // Small-medium enterprise
  INDIVIDUAL
  GOVERNMENT
  SEMI_GOVERNMENT  // Aramco, SABIC, etc.
}

enum PaymentTerms {
  CASH
  COD              // Cash on delivery
  NET_15
  NET_30
  NET_45
  NET_60
  NET_90
  PREPAID
  CREDIT
}

enum IndustryType {
  FMCG              // Fast-moving consumer goods
  CONSTRUCTION
  OIL_GAS
  PETROCHEMICAL
  HEALTHCARE
  PHARMACEUTICAL
  FOOD_BEVERAGE
  RETAIL
  ECOMMERCE
  MANUFACTURING
  AUTOMOTIVE
  AGRICULTURE
  MINING
  TELECOMMUNICATIONS
  LOGISTICS
  GOVERNMENT
  EDUCATION
  OTHER
}

model Customer {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Company Identity ──
  accountNumber   String         @unique  // Auto-generated: CUS-001
  companyName     String
  companyNameAr   String?                  // Arabic company name (Secondary Language)
  tradeName       String?                  // DBA / trading name
  division        String?                  // DIVISION
  brand           String?                  // Brand
  customerType    CustomerType   @default(CORPORATE)
  customerSubType String?                  // Customer Sub Type
  status          CustomerStatus @default(ACTIVE)
  industryType    IndustryType?

  // ── Saudi Commercial Registration & Tax ──
  crNumber        String?        @unique   // Commercial Registration (سجل تجاري)
  crExpiryDate    DateTime?                // ⚠️ Compliance
  vatNumber       String?        @unique   // ZATCA VAT number / Tax Registration Number (15 digits)
  vatTreatment    String?                  // VAT Treatment (e.g. VAT Registered, Non-VAT, etc.)
  zakatCertNumber String?                  // Zakat & Tax certificate
  zakatCertExpiry DateTime?                // ⚠️ Compliance
  nationalAddress String?                  // Saudi National Address (short code)

  // ── Primary Contact ──
  contactPerson   String
  contactTitle    String?                  // e.g. Logistics Manager
  email           String         @unique
  phone           String
  alternatePhone  String?
  whatsapp        String?                  // WhatsApp number (widely used in KSA)

  // ── Additional Contacts (JSON) ──
  additionalContacts String?               // JSON array: [{ name, title, email, phone, role }]

  // ── Billing Address (ZATCA & ERP Compatible) ──
  billingAttention        String?          // Billing Attention (Name/Dept)
  billingAddress          String?          // Billing Address (Street line 1)
  billingStreet2          String?          // Billing Street2 (Street line 2)
  billingDistrict         String?          // Billing District (الحي)
  billingCity             String?          // e.g. Riyadh, Jeddah, Dammam
  billingRegion           String?          // Billing State / Region / Province
  billingPostalCode       String?          // Billing Code / Postal Code (5 digits)
  billingAdditionalNumber String?          // Billing Additional Number (الرقم الإضافي - 4 digits)
  billingCountry          String?      @default("SA")

  // ── Shipping / Operations Address ──
  shippingAddress   String?
  shippingCity      String?
  shippingRegion    String?
  shippingPostalCode String?
  shippingCountry   String?     @default("SA")

  // ── Financial & Payment ──
  paymentTerms      PaymentTerms @default(NET_30)
  paymentTermsLabel String?                 // Payment Terms Label (custom label)
  creditLimitSar    Float?                 // Credit limit in SAR
  openingBalance    Float?       @default(0) // Opening Balance
  currentBalanceSar Float?       @default(0) // Outstanding / current balance
  bankName          String?
  ibanNumber        String?                // Saudi IBAN (SA + 22 digits)
  currency          String?      @default("SAR")

  // ── Pricing & Rates ──
  discountPercent   Float?       @default(0) // Default discount %
  specialRateCard   String?                  // JSON: custom rates per route/service
  contractStartDate DateTime?
  contractEndDate   DateTime?              // ⚠️ Renewal tracking
  contractDocUrl    String?                 // Uploaded contract file

  // ── Service Preferences ──
  preferredVehicleTypes String?             // Comma-separated slugs
  requiresColdChain    Boolean  @default(false)
  requiresHazmat       Boolean  @default(false)
  requiresInsuredCargo Boolean  @default(false)
  defaultPickupCity    String?
  defaultDeliveryCity  String?

  // ── Account Management ──
  accountManagerName String?               // Internal AM assigned
  salesRepName       String?               // Sales representative
  referralSource     String?               // How they found us
  tags               String?               // Comma-separated tags for filtering

  // ── Notes & Metadata ──
  notes            String?
  logoUrl          String?                 // Company logo
  website          String?

  // ── Relations ──
  orders Order[]
  user   User?
}

enum OrderStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model Order {
  id                String      @id @default(uuid())
  customerId        String
  customer          Customer    @relation(fields: [customerId], references: [id])
  pickupLocation    String
  dropoffLocation   String
  assignedDriverId  String?
  driver            Driver?     @relation(fields: [assignedDriverId], references: [id])
  assignedVehicleId String?
  vehicle           Vehicle?    @relation(fields: [assignedVehicleId], references: [id])
  status            OrderStatus @default(PENDING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}
